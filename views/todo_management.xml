        <record id="check_task_late" model="ir.cron">
            <field name="name">ToDo: Date Check</field>
            <field name="model_id" ref="model_todo_management"/>
            <field name="state">code</field>
            <field name="code">model.late_task()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    <record id="todo_closed_server_action" model="ir.actions.server">
        <field name="name">ToDo Closed</field>
        <field name="model_id" ref="model_todo_management"/>
        <field name="binding_model_id" ref="model_todo_management"/>
        <field name="state">code</field>
        <field name="code">
            action= records.action_close()
        </field>
    </record>

    <record id="todo_action" model="ir.actions.act_window">
        <field name="name">todo action</field>
        <field name="res_model">todo_management</field>
    </record>
    <menuitem
            id="task_menu_item"
            name="Task"
            parent="to_do_menu"
            action="todo_action"
    />
</odoo>