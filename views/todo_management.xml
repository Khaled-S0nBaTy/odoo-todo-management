<odoo>
    <record id="todo_view_tree" model="ir.ui.view">
        <field name="name">todo tree</field>
        <field name="model">todo_management</field>
        <field name="arch" type="xml">
            <tree multi_edit="1" class="header_custom" decoration-danger="(is_late)">
                <field name="task_name"/>
                <field name="due_date"/>
                <field name="is_late" invisible="true"/>
                <field name="estimated_time"/>
                <field name="status"/>
                <field name="assign_to_id"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="todo_view_form" model="ir.ui.view">
        <field name="name">todo form</field>
        <field name="model">todo_management</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_new" type="object" class="btn-primary" string="Add New Task"
                                invisible="status not in ('in_progress', 'completed')"/>

                        <button name="action_in_progress" type="object" class="btn-secondary" string="In Progress"
                                invisible="status not in ('new', 'completed')"/>

                        <button name="action_completed" type="object" class="btn-success" string="Task Completed"
                                invisible="status != 'in_progress'"/>

                        <field name="status" widget="statusbar"/>
                    </header>
                    <div class="oe_title">
                        <label for="task_name"/>
                        <h1>
                            <field name="task_name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="due_date"/>
                            <field name="is_late" />
                            <field name="assign_to_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="estimated_time"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Task">
                            <field name="task_line_ids">
                                <tree editable="bottom">
                                    <field name="description"/>
                                    <field name="time"/>
                                    <field name="date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

